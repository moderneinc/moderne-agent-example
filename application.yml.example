# Moderne Connector configuration template.
#
# Copy to application.yml and customize for your environment. Mount the file
# into the container at /app/application.yml (or set SPRING_CONFIG_LOCATION
# to point at it) and the connector will pick it up at startup.
#
# Spring Boot relaxed binding: kebab-case keys here are equivalent to the
# camelCase / SCREAMING_SNAKE_CASE forms used elsewhere in Moderne docs.

moderne:

  # ==========================================================================
  # CORE CONNECTOR CONFIGURATION (Required)
  # ==========================================================================
  connector:
    # URI for the connector's RSocket tunnel to the Moderne API gateway.
    # Format: https://api.<tenant>.moderne.io/connector
    # (Legacy /rsocket paths are auto-rewritten to /connector at startup.)
    api-gateway-rsocket-uri: https://api.<tenant>.moderne.io/connector

    # Connector authentication token (provided by Moderne).
    token: <your-connector-token>

    # 256-bit AES symmetric key (hex) used to encrypt LSTs in transit/at rest.
    # Generate with: openssl enc -aes-256-cbc -k secret -P -md sha256
    # Use the value after "key=". Keep stable: changing it makes previously
    # encrypted LSTs unreadable.
    crypto:
      symmetric-key: <your-256-bit-hex-key>

    # Human-readable identifier for this connector instance (shown in the UI
    # and metrics). Use lowercase with hyphens.
    nickname: my-connector

    # ========================================================================
    # HTTP PROXY FOR API GATEWAY (Optional)
    # ========================================================================
    # Outbound proxy used by the RSocket tunnel. Both host and port required.
    #api-gateway:
    #  proxy:
    #    host: proxy.mycompany.com
    #    port: 8080

    # ========================================================================
    # ORGANIZATION POLLING CADENCE (Optional)
    # ========================================================================
    # Connector-wide defaults for the LST discovery loop. The per-source poll
    # repos (Artifactory / Maven) are NOT configured here -- they live under
    # each source at moderne.organization.sources.{http,s3,file}[*].poll (see
    # the ORGANIZATION SOURCES section below). A global poll block here fails
    # fast at startup.
    organization:
      # How often the connector re-fetches each source's repos.csv and re-runs
      # enrichment (ISO-8601 duration; default PT10M).
      #interval: PT10M

      # Global cap on concurrent LST download/encrypt/upload operations across
      # all sources. Default: max(4, available CPU cores).
      #download-parallelism: 8

    # ========================================================================
    # POM CACHE (Optional - improves recipe execution performance)
    # ========================================================================
    #recipe:
    #  pom-cache:
    #    # Cache backend: IN_MEMORY (default) or REDIS.
    #    type: IN_MEMORY
    #
    #    # TTLs (ISO-8601 durations).
    #    pom-ttl: PT1H
    #    metadata-ttl: PT10M
    #
    #    # Redis backend (only used when type=REDIS).
    #    redis:
    #      host: redis.mycompany.com
    #      port: 6379
    #      username:
    #      password:
    #      ssl: false
    #      database: 0

    # ========================================================================
    # GENERIC HTTP TOOLS (Optional)
    # ========================================================================
    # Pre-authenticated outbound HTTP endpoints exposed to recipes.
    #http-tool:
    #  - uri: https://internal-tool.mycompany.com
    #    username:
    #    password:
    #    #bearer-token:
    #    #proxy:
    #    #  host:
    #    #  port:
    #    skip-ssl: false
    #    skip-validate-connectivity: false

  # ==========================================================================
  # SCM PROVIDERS (Optional)
  # ==========================================================================
  scm:
    # GitHub (one or more instances).
    #github:
    #  - uri: https://github.com
    #    oauth:
    #      client-id: <github-oauth-client-id>
    #      client-secret: <github-oauth-client-secret>
    #      include-private-repos: true
    #    # Restrict to specific organizations.
    #    allowable-organizations:
    #      - my-org
    #      - another-org
    #    #proxy:
    #    #  host: proxy.mycompany.com
    #    #  port: 8080
    #    skip-ssl: false
    #    skip-validate-connectivity: false

    # GitLab.
    #gitlab:
    #  - uri: https://gitlab.com
    #    oauth:
    #      client-id: <gitlab-oauth-client-id>
    #      client-secret: <gitlab-oauth-client-secret>
    #    skip-ssl: false
    #    skip-validate-connectivity: false

    # Bitbucket Data Center.
    #bitbucket-datacenter:
    #  - uri: https://bitbucket.mycompany.com
    #    # OAuth 2.0 (preferred). Mutually exclusive with private-key.
    #    oauth:
    #      key: <bitbucket-oauth-key>
    #      secret: <bitbucket-oauth-secret>
    #    # OAuth 1.0 (legacy application links).
    #    #private-key: |
    #    #  -----BEGIN RSA PRIVATE KEY-----
    #    #  ...
    #    #  -----END RSA PRIVATE KEY-----
    #    skip-ssl: false
    #    skip-validate-connectivity: false

    # Bitbucket Cloud (single instance, not a list).
    #bitbucket-cloud:
    #  oauth:
    #    key: <bitbucket-cloud-oauth-key>
    #    secret: <bitbucket-cloud-oauth-secret>
    #  skip-validate-connectivity: false

    # Azure DevOps.
    #azure-devops:
    #  - oauth:
    #      client-id: <azure-oauth-client-id>
    #      client-secret: <azure-oauth-client-secret>
    #      tenant-id: <azure-tenant-id>
    #    skip-validate-connectivity: false

    # Restrict commit strategies offered to users.
    # Options: Direct, Branch, Fork, PullRequest, ForkAndPullRequest, None
    #default-commit-options:
    #  - PullRequest
    #  - ForkAndPullRequest

  # ==========================================================================
  # ORGANIZATION SOURCES (Optional - repos.csv hierarchy)
  # ==========================================================================
  # The connector loads its repository list from one or more sources. Mix and
  # match HTTP, S3, and file-based sources. See README for repos.csv format.
  #
  # Each source may carry an optional `poll:` block listing the Artifactory
  # and/or Maven repositories to query for that source's LST artifacts. Polling
  # is configured per source (not globally) because the connector must know
  # which source's repos.csv each poll relates to.
  #organization:
  #  sources:
  #    # HTTP-hosted repos.csv.
  #    http:
  #      - uri: https://example.com/repos.csv
  #        username:
  #        password:
  #        #bearer-token:
  #        #proxy:
  #        #  host:
  #        #  port:
  #        # Encrypt LSTs in transit / at rest (default: true).
  #        #encrypt: true
  #        #skip-ssl: false
  #        #skip-validate-connectivity: false
  #
  #        # ================================================================
  #        # ARTIFACTORY / MAVEN POLLING for THIS source (Optional)
  #        # ================================================================
  #        #poll:
  #        #  # Artifactory polling (recommended for LST storage).
  #        #  artifactory:
  #        #    - uri: https://artifactory.mycompany.com/artifactory
  #        #      # Use EITHER username/password OR bearer-token.
  #        #      username: <artifactory-username>
  #        #      password: <artifactory-password>
  #        #      #bearer-token: <artifactory-token>
  #        #      # AQL filter expressions that select LST artifacts.
  #        #      lst-query-filters:
  #        #        - '"repo":{"$match":"moderne-lsts"}'
  #        #        - '"name":{"$match":"*-ast.jar"}'
  #        #      # How often to re-poll (ISO-8601 duration; default PT10M).
  #        #      interval: PT10M
  #        #      # Per-source download concurrency override (defaults to global).
  #        #      download-parallelism: 4
  #        #      skip-ssl: false
  #        #      skip-validate-connectivity: false
  #        #
  #        #  # Maven polling (alt to Artifactory; also a dependency source).
  #        #  maven:
  #        #    - uri: https://artifactory.mycompany.com/artifactory/my-repository
  #        #      username: <maven-username>
  #        #      password: <maven-password>
  #        #      # Local cache directory (defaults to ~/.moderne-maven).
  #        #      local-repository: /app/.moderne-maven/maven0
  #        #      # Include releases / snapshots (default: true).
  #        #      releases: true
  #        #      snapshots: true
  #        #      # Poll interval (ISO-8601 duration; default PT10M).
  #        #      interval: PT10M
  #        #      skip-ssl: false
  #        #      skip-validate-connectivity: false
  #
  #    # S3-hosted repos.csv (or repos-lock.csv).
  #    s3:
  #      - uri: s3://my-bucket/path/repos-lock.csv
  #        region: us-west-2
  #        #endpoint-url:
  #        #access-key:
  #        #secret-key:
  #        #profile:
  #        #encrypt: true
  #        # A `poll:` block (same shape as the http example above) is valid here too.
  #
  #    # File-mounted repos.csv (path relative to the connector's storage dir).
  #    file:
  #      - path: repos.csv
  #        #encrypt: true
  #        # A `poll:` block (same shape as the http example above) is valid here too.

  # ==========================================================================
  # RECIPE MARKETPLACE (Optional)
  # ==========================================================================
